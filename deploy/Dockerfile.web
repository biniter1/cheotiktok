# Build frontend rồi gói vào Caddy (reverse proxy + HTTPS tự động + phục vụ file tĩnh)
FROM node:22-alpine AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
ARG VITE_FAKE_FOLLOW=0
ENV VITE_FAKE_FOLLOW=$VITE_FAKE_FOLLOW
RUN npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /web/dist /srv/web
