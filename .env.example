DATABASE_URL=postgres://app:app@postgres:5432/cheo
REDIS_URL=redis://redis:6379
# openssl rand -hex 32
JWT_SECRET=change-me
# openssl rand -base64 32
TOKEN_ENC_KEY=change-me
FRONTEND_URL=http://localhost:5173

# TikTok for Developers (Login Kit + scope user.info.basic, user.info.profile, user.info.stats)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8080/auth/tiktok/callback

# 1 = giả lập TikTok (dev / load test). KHÔNG bật ở production.
TIKTOK_MOCK=1

LOG_LEVEL=info
RATE_LIMIT_PER_MIN=120
PG_POOL_MAX=10
MATCH_CONFIRM_TIMEOUT_SEC=90
MATCH_VERIFY_GRACE_SEC=15
POLL_INTERVAL_MIN=15
POLL_MAX_PER_MIN=300
CORRELATE_DELAY_SEC=180
